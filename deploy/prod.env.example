# Copied to the VPS as deploy/prod.env and consumed by the deploy job.
# Fill these with the real values (in the repo's GitHub → Settings → Secrets,
# the deploy step reads these as workflow secrets and writes prod.env on the box).

# Mikku runtime
MONGO_URI=mongodb+srv://<user>:<pw>@<cluster>/mikku?retryWrites=true&w=majority
PUBLIC_BASE_URL=https://<your-backend-url>
JWT_SECRET=<long-random-string>
ALLOWED_ORIGINS=https://<your-frontend-url>